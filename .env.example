# Copy to .env.local and fill in. Never commit the real file.

# Postgres connection string for the `app` role (see infra/postgres/init/00-roles.sh
# and infra/README.md). Local dev default matches infra/.env's APP_DB_PASSWORD.
# Port 5434, not 5432 — matches infra/docker-compose.yml's POSTGRES_HOST_PORT
# default (this machine's other local Postgres installs squat on 5432/5433).
DATABASE_URL=postgres://app:sbmj-dev-app@localhost:5434/sbmj_erp

# One-time bootstrap admin account (see scripts/seed-admin.ts). Only needed to run
# the seed script once against a fresh database.
SEED_ADMIN_EMAIL=admin@sbmj.co.id
SEED_ADMIN_PASSWORD=change-me-admin
