# Copy to .env.local and fill in. Never commit the real file.

# Postgres connection string for the `app` role (see infra/postgres/init/00-roles.sh
# and infra/README.md). Local dev default matches infra/.env's APP_DB_PASSWORD.
# Port 5434, not 5432 — matches infra/docker-compose.yml's POSTGRES_HOST_PORT
# default (this machine's other local Postgres installs squat on 5432/5433).
DATABASE_URL=postgres://app:sbmj-dev-app@localhost:5434/sbmj_erp

# One-time bootstrap admin account (see scripts/seed-admin.ts). Only needed to run
# the seed script once against a fresh database.
SEED_ADMIN_EMAIL=admin@sbmj.co.id
SEED_ADMIN_PASSWORD=change-me-admin
# Optional — defaults to "Admin" if unset.
SEED_ADMIN_NAME=Admin

# 32-byte AES-256-GCM key (base64), used to encrypt the Pengiriman SMTP password
# at rest (src/lib/crypto.ts). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Error reporting (src/lib/observability/sentry.ts) — optional, no-ops
# entirely when unset (errors still land in container logs via Pino either
# way). Set on both the App and Worker deployments if used.
SENTRY_DSN=
# Pino log level (src/lib/observability/logger.ts). Optional, defaults to "info".
LOG_LEVEL=info

# Used only by scripts/worker.ts to attach a real PDF to Pengiriman emails —
# it headlessly renders src/app/print/** (a running Next server) via
# Playwright, so it needs the app's own base URL plus a shared secret those
# routes check instead of a login session. Generate the secret with:
# openssl rand -base64 32. Both optional in dev — the worker only errors if
# a delivery actually needs a PDF and one of these is unset.
APP_URL=http://localhost:3000
INTERNAL_RENDER_SECRET=

# MinIO (S3-compatible object storage — docs/architecture.md §6). Matches
# infra/.env's MINIO_ROOT_USER/MINIO_ROOT_PASSWORD for local dev. Only
# checked when an upload route actually runs (src/lib/storage/s3.ts), same
# "optional until used" pattern as APP_URL/INTERNAL_RENDER_SECRET above.
S3_ENDPOINT=http://localhost:9000
# Same as S3_ENDPOINT in this plain `npm run dev` setup — diverges once the
# app runs in its own container (see infra/docker-compose.yml's `app`
# service for the internal-vs-public split, and infra/COOLIFY.md).
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=sbmj-minio
S3_SECRET_KEY=sbmj-dev-minio
S3_BUCKET=sbmj-erp
# Object keys are namespaced under this prefix (e.g. testing/logos/<uuid>.png)
# so this environment's uploads stay separate from a future prod prefix
# sharing the same bucket. infra/scripts/minio-init.sh grants anonymous read
# on exactly this prefix.
S3_KEY_PREFIX=testing

# Dev tool only (scripts/screenshot-docs.ts) — base URL it screenshots
# against. Optional, defaults to http://localhost:3000.
SCREENSHOT_BASE_URL=http://localhost:3000
