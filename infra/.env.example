# Copy to infra/.env and fill in. Never commit the real .env.

# --- Postgres ---
POSTGRES_DB=sbmj_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-app-role   # password for the LOGIN role `app`
# Host-side port mapping (container always listens on 5432 internally).
# Default avoids colliding with other local Postgres installs on 5432/5433.
POSTGRES_HOST_PORT=5434

# --- MinIO ---
MINIO_ROOT_USER=sbmj-minio
MINIO_ROOT_PASSWORD=change-me-minio
# Upload bucket + key prefix (infra/scripts/minio-init.sh creates the bucket
# and grants anonymous read on exactly this prefix — see infra/COOLIFY.md).
S3_BUCKET=sbmj-erp
S3_KEY_PREFIX=testing

# --- App + Worker ---
# 32-byte AES-256-GCM key (base64) — encrypts the Pengiriman SMTP password at
# rest (src/lib/crypto.ts). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Shared secret the worker uses to call the app's internal src/app/print/**
# routes (PDF-attachment rendering) — must be identical on both services.
# Generate with: openssl rand -base64 32
INTERNAL_RENDER_SECRET=
# Optional — GlitchTip/Sentry free hosted tier (docs/architecture.md §8).
# Error tracking works without it, just logs to stdout/Coolify instead.
SENTRY_DSN=

# --- Coolify API (deployment automation scripts, infra/scripts/coolify-*.sh) ---
# Your Coolify instance, no trailing slash, e.g. https://coolify.yourdomain.com
COOLIFY_BASE_URL=
# Generate in Coolify UI: Keys & Tokens → Create New Token.
COOLIFY_API_TOKEN=
