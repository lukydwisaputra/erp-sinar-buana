# Copy to infra/.env and fill in. Never commit the real .env.

# --- Postgres ---
POSTGRES_DB=sbmj_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-app-role   # password for the LOGIN role `app`
# Host-side port mapping (container always listens on 5432 internally).
# Default avoids colliding with other local Postgres installs on 5432/5433.
POSTGRES_HOST_PORT=5434

# --- MinIO ---
MINIO_ROOT_USER=sbmj-minio
MINIO_ROOT_PASSWORD=change-me-minio

# --- App (uncomment app/worker in docker-compose.yml to use) ---
RESEND_API_KEY=
SENTRY_DSN=
